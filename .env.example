# ============================================================
# EventKraft — Environment Variables
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# Session
SESSION_SECRET=your_session_secret_here

# PostgreSQL Database (Supabase)
DATABASE_URL=postgresql://user:password@host:5432/database

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth (fill in from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Email SMTP (fill in for email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=EventKraft <noreply@eventkraft.com>

# eSewa Payment Gateway
ESEWA_MERCHANT_CODE=your_esewa_merchant_code_here
ESEWA_SECRET_KEY=your_esewa_secret_key_here
ESEWA_ENV=sandbox
APP_URL=http://localhost:3000
