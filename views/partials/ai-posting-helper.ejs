<%# AI posting helper — include with: include('../partials/ai-posting-helper', { aiMode: 'job' | 'gig' }) %>
<div class="ek-card ai-post-helper mb-4" id="aiPostHelper" data-ai-mode="<%= aiMode %>" style="padding:0;overflow:hidden">
    <button type="button" class="ai-post-helper__head" id="aiPostToggle">
        <span class="ai-post-helper__title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 4.6L18.5 9.5l-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3z"/><path d="M19 14l.9 2.1L22 17l-2.1.9L19 20l-.9-2.1L16 17l2.1-.9L19 14z"/></svg>
            <strong>Describe it — let AI fill the form</strong>
        </span>
        <span class="ai-post-helper__chevron">▾</span>
    </button>
    <div class="ai-post-helper__body d-none" id="aiPostBody">
        <div class="ai-post-helper__messages" id="aiPostMessages"></div>
        <form class="ai-post-helper__inputrow" id="aiPostForm" autocomplete="off">
            <input type="text" class="form-control" id="aiPostInput" maxlength="2000"
                   placeholder="<%= aiMode === 'job' ? 'e.g. I need a photographer for my wedding in Pokhara on Dec 5, budget around 50k…' : 'e.g. I do cinematic wedding videography with drone shots, starting at 40k…' %>">
            <button type="submit" class="btn btn-ek-primary" id="aiPostSend">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
            </button>
        </form>
    </div>
</div>

<style>
    .ai-post-helper__head { display:flex; justify-content:space-between; align-items:center; width:100%;
        background:var(--ek-gradient-subtle, linear-gradient(135deg,rgba(107,29,42,.06),rgba(140,58,74,.1)));
        border:none; padding:.9rem 1.25rem; cursor:pointer; color:var(--ek-text); }
    .ai-post-helper__title { display:flex; align-items:center; gap:.5rem; color:var(--ek-maroon,#6b1d2a); }
    .ai-post-helper__chevron { color:var(--ek-text-muted); transition:transform .2s; }
    .ai-post-helper.is-open .ai-post-helper__chevron { transform:rotate(180deg); }
    .ai-post-helper__messages { max-height:280px; overflow-y:auto; padding:1rem 1.25rem; display:flex; flex-direction:column; gap:.5rem; }
    .ai-post-msg { max-width:85%; padding:.55rem .9rem; border-radius:14px; font-size:.88rem; line-height:1.5; white-space:pre-wrap; }
    .ai-post-msg--user { align-self:flex-end; background:var(--ek-maroon,#6b1d2a); color:#fff; border-bottom-right-radius:4px; }
    .ai-post-msg--bot { align-self:flex-start; background:var(--ek-cream,#f6f1ea); color:var(--ek-text,#333); border-bottom-left-radius:4px; }
    .ai-post-msg--done { align-self:stretch; background:rgba(25,135,84,.1); border:1px solid rgba(25,135,84,.35); color:var(--ek-text,#333); border-radius:10px; }
    .ai-post-helper__inputrow { display:flex; gap:.5rem; padding: .75rem 1.25rem 1rem; border-top:1px solid var(--ek-border,#eee); }
    .ai-post-typing { align-self:flex-start; opacity:.6; font-size:.85rem; }
</style>
<script src="/js/ai-posting.js"></script>
