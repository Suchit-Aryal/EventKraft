<%
  const pc = locals.profileCompletion || { percentage: 100, steps: [] };
  const pcPercentage = Math.max(0, Math.min(100, Math.round(Number(pc.percentage) || 0)));
%>

<aside class="sidebar" id="sidebar">

  <!-- User card -->
  <div class="sidebar__usercard">
    <div class="sidebar__uc-avatar-wrap">
      <img src="<%= locals.currentUser.avatar_url || '/images/default-avatar.png' %>"
           class="sidebar__uc-avatar" alt="<%= locals.currentUser.first_name || 'User' %>">
      <% if (locals.currentUser.is_admin_verified) { %>
        <span class="sidebar__uc-verified" title="Verified">
          <svg width="8" height="8" viewBox="0 0 10 10" fill="#fff">
            <path d="M1 5L4 8L9 2"/>
          </svg>
        </span>
      <% } %>
    </div>
    <div class="sidebar__uc-info">
      <span class="sidebar__uc-name">
        <%= locals.currentUser.first_name || '' %> <%= locals.currentUser.last_name || '' %>
      </span>
      <span class="sidebar__uc-role-pill sidebar__uc-role-pill--<%= locals.currentUser.role %>">
        <%= locals.currentUser.role === 'worker' ? 'Service Provider' : locals.currentUser.role === 'admin' ? 'Admin' : 'Customer' %>
      </span>
    </div>
  </div>

  <!-- Profile completion bar (only if incomplete) -->
  <% if (pcPercentage < 100) { %>
    <% const nextSteps = (pc.steps || []).filter(step => !step.done).slice(0, 3); %>
    <div class="sidebar__completion">
      <div class="sidebar__completion-top">
        <span><%= pcPercentage %>% complete</span>
        <a class="sidebar__completion-cta" href="/dashboard/profile">Improve</a>
      </div>
      <div class="sidebar__completion-track">
        <div class="sidebar__completion-fill" style="width:<%= pcPercentage %>%"></div>
      </div>
      <% if (nextSteps.length > 0) { %>
        <div class="sidebar__completion-list">
          <% nextSteps.forEach(function(step) { %>
            <a href="<%= step.href %>" class="sidebar__completion-step">
              <span><%= step.label %></span>
              <strong>+<%= step.impact ?? step.points ?? 0 %>%</strong>
            </a>
          <% }); %>
        </div>
      <% } %>
    </div>
  <% } %>

  <!-- Navigation -->
  <nav class="sidebar__nav" aria-label="Dashboard navigation">

    <span class="sidebar__group-label">Main</span>

    <a href="/dashboard"
       class="sidebar__item <%= locals.activePage === 'overview' ? 'sidebar__item--active' : '' %>">
      <%- icons.grid %>
      <span>Dashboard</span>
    </a>

    <a href="/bookings"
       class="sidebar__item <%= locals.activePage === 'bookings' ? 'sidebar__item--active' : '' %>">
      <%- icons.calendar %>
      <span>Bookings</span>
    </a>

    <a href="/messages"
       class="sidebar__item <%= (locals.activePage === 'inbox' || locals.activePage === 'messages') ? 'sidebar__item--active' : '' %>">
      <%- icons.chat %>
      <span>Inbox</span>
      <% if ((locals.unreadMsgs || 0) > 0) { %>
        <em class="sidebar__badge"><%= locals.unreadMsgs %></em>
      <% } %>
    </a>

    <span class="sidebar__group-label">Discover</span>

    <a href="/gigs"
       class="sidebar__item <%= (locals.activePage === 'browse-services' || (locals.activePage === 'gigs' && locals.currentUser.role !== 'worker')) ? 'sidebar__item--active' : '' %>">
      <%- icons.search %>
      <span>Browse Services</span>
    </a>

    <a href="/jobs"
       class="sidebar__item <%= (locals.activePage === 'browse-jobs' || (locals.activePage === 'jobs' && locals.currentUser.role !== 'customer')) ? 'sidebar__item--active' : '' %>">
      <%- icons.briefcase %>
      <span>Browse Gigs</span>
    </a>

    <!-- Role-specific section -->
    <% if (locals.currentUser.role === 'customer') { %>

      <span class="sidebar__group-label">My Work</span>

      <a href="/jobs/mine"
         class="sidebar__item <%= locals.activePage === 'my-jobs' ? 'sidebar__item--active' : '' %>">
        <%- icons.briefcase %>
        <span>My Gigs</span>
      </a>

      <a href="/jobs/create"
         class="sidebar__item sidebar__item--create <%= (locals.activePage === 'post-job' || locals.activePage === 'create-job') ? 'sidebar__item--active' : '' %>">
        <%- icons.plus %>
        <span>Post a Gig</span>
      </a>

    <% } else if (locals.currentUser.role === 'worker') { %>

      <span class="sidebar__group-label">My Work</span>

      <a href="/gigs/mine"
         class="sidebar__item <%= locals.activePage === 'my-services' ? 'sidebar__item--active' : '' %>">
        <%- icons.star %>
        <span>My Services</span>
      </a>

      <a href="/jobs/my-proposals"
         class="sidebar__item <%= locals.activePage === 'proposals' ? 'sidebar__item--active' : '' %>">
        <%- icons.send %>
        <span>My Proposals</span>
      </a>

      <%
        const canPost = locals.currentUser.kyc_status === 'approved'
          && locals.currentUser.avatar_url
          && locals.currentUser.bio
          && (locals.currentUser.bio || '').trim().split(/\s+/).filter(Boolean).length >= 50;
      %>

      <a href="<%= canPost ? '/gigs/create' : '/dashboard/profile' %>"
         class="sidebar__item sidebar__item--create <%= !canPost ? 'sidebar__item--locked' : '' %>
                <%= locals.activePage === 'post-service' ? 'sidebar__item--active' : '' %>"
         <% if (!canPost) { %> title="Complete your profile to post services" <% } %>>
        <%- icons.plus %>
        <span>Post a Service</span>
        <% if (!canPost) { %>
          <span class="sidebar__lock-icon"><i class="bi bi-lock"></i></span>
        <% } %>
      </a>

    <% } %>

    <% if (locals.currentUser.role === 'admin') { %>

      <span class="sidebar__group-label">Admin</span>

      <a href="/admin"
         class="sidebar__item <%= locals.activePage === 'admin' ? 'sidebar__item--active' : '' %>">
        <%- icons.grid %>
        <span>Admin Overview</span>
      </a>

      <a href="/admin/users"
         class="sidebar__item <%= locals.activePage === 'admin-users' ? 'sidebar__item--active' : '' %>">
        <%- icons.user %>
        <span>Users</span>
      </a>

      <a href="/admin/bookings"
         class="sidebar__item <%= locals.activePage === 'admin-bookings' ? 'sidebar__item--active' : '' %>">
        <%- icons.calendar %>
        <span>Bookings</span>
      </a>

      <a href="/admin/services"
         class="sidebar__item <%= locals.activePage === 'admin-services' ? 'sidebar__item--active' : '' %>">
        <%- icons.star %>
        <span>Services</span>
      </a>

      <a href="/admin/jobs"
         class="sidebar__item <%= locals.activePage === 'admin-jobs' ? 'sidebar__item--active' : '' %>">
        <%- icons.briefcase %>
        <span>Jobs</span>
      </a>

      <a href="/admin/transactions"
         class="sidebar__item <%= locals.activePage === 'admin-transactions' ? 'sidebar__item--active' : '' %>">
        <%- icons.dollar %>
        <span>Transactions</span>
      </a>

      <a href="/admin/categories"
         class="sidebar__item <%= locals.activePage === 'admin-categories' ? 'sidebar__item--active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
        <span>Categories</span>
      </a>

      <a href="/admin/reviews"
         class="sidebar__item <%= locals.activePage === 'admin-reviews' ? 'sidebar__item--active' : '' %>">
        <%- icons.star %>
        <span>Reviews</span>
      </a>

      <a href="/admin/kyc"
         class="sidebar__item <%= locals.activePage === 'admin-kyc' ? 'sidebar__item--active' : '' %>">
        <%- icons.settings %>
        <span>KYC Verification</span>
      </a>

      <a href="/admin/disputes"
         class="sidebar__item <%= locals.activePage === 'admin-disputes' ? 'sidebar__item--active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <span>Disputes</span>
      </a>

      <a href="/admin/commissions"
         class="sidebar__item <%= locals.activePage === 'admin-commissions' ? 'sidebar__item--active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
        <span>Commissions</span>
      </a>

      <a href="/admin/legal-action"
         class="sidebar__item <%= locals.activePage === 'admin-legal' ? 'sidebar__item--active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        <span>Legal Action</span>
      </a>

    <% } %>

    <span class="sidebar__group-label">Account</span>

    <a href="/dashboard/profile"
       class="sidebar__item <%= locals.activePage === 'profile' ? 'sidebar__item--active' : '' %>">
      <%- icons.user %>
      <span>My Profile</span>
    </a>

    <a href="/dashboard/notifications"
       class="sidebar__item <%= locals.activePage === 'notifications' ? 'sidebar__item--active' : '' %>">
      <%- icons.bell %>
      <span>Notifications</span>
      <% if ((locals.unreadNotifs || 0) > 0) { %>
        <em class="sidebar__badge"><%= locals.unreadNotifs %></em>
      <% } %>
    </a>

    <a href="/dashboard/settings"
       class="sidebar__item <%= locals.activePage === 'settings' ? 'sidebar__item--active' : '' %>">
      <%- icons.settings %>
      <span>Account Settings</span>
    </a>

  </nav>

  <!-- Footer links -->
  <div class="sidebar__foot">
    <a href="#">Help</a>
    <span>·</span>
    <a href="#">Terms</a>
    <span>·</span>
    <a href="#">Privacy</a>
  </div>

</aside>
