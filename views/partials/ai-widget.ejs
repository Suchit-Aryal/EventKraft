<!-- EventKraft AI Assistant — floating widget (bottom-left; messaging chat owns bottom-right) -->
<link rel="stylesheet" href="/css/ai-chat.css">
<div id="ekAiWidget" class="ek-ai-widget" data-ek-ai>
    <button type="button" class="ek-ai-toggle" aria-label="Open EventKraft Assistant" title="EventKraft Assistant">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 4.6L18.5 9.5l-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3z"/><path d="M19 14l.9 2.1L22 17l-2.1.9L19 20l-.9-2.1L16 17l2.1-.9L19 14z"/></svg>
    </button>
    <div class="ek-ai-panel" hidden>
        <div class="ek-ai-header">
            <div class="ek-ai-header-title">
                <span class="ek-ai-dot"></span>
                <div>
                    <strong>EventKraft Assistant</strong>
                    <small>Ask about services, budgets &amp; ideas</small>
                </div>
            </div>
            <div class="ek-ai-header-actions">
                <a href="/assistant" class="ek-ai-maximize" title="Open full page" aria-label="Open full page">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>
                </a>
                <button type="button" class="ek-ai-minimize" title="Minimize" aria-label="Minimize assistant">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
            </div>
        </div>
        <div class="ek-ai-messages" aria-live="polite"></div>
        <form class="ek-ai-inputrow" autocomplete="off">
            <input type="text" class="ek-ai-input" maxlength="2000" placeholder="e.g. I have NPR 20,000 for a wedding…" aria-label="Message the assistant">
            <button type="submit" class="ek-ai-send" aria-label="Send">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
            </button>
        </form>
    </div>
</div>
<script src="/js/ai-chat.js"></script>
