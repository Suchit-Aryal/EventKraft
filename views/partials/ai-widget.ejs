<!-- EventKraft AI Assistant — floating widget (bottom-left; messaging chat owns bottom-right) -->
<link rel="stylesheet" href="/css/ai-chat.css">
<div id="ekAiWidget" class="ek-ai-widget">
    <button type="button" id="ekAiToggle" class="ek-ai-toggle" aria-label="Open EventKraft Assistant" title="EventKraft Assistant">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 4.6L18.5 9.5l-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3z"/><path d="M19 14l.9 2.1L22 17l-2.1.9L19 20l-.9-2.1L16 17l2.1-.9L19 14z"/></svg>
    </button>
    <div id="ekAiPanel" class="ek-ai-panel" hidden>
        <div class="ek-ai-header">
            <div class="ek-ai-header-title">
                <span class="ek-ai-dot"></span>
                <div>
                    <strong>EventKraft Assistant</strong>
                    <small>Ask about services, budgets &amp; ideas</small>
                </div>
            </div>
            <div class="ek-ai-header-actions">
                <button type="button" id="ekAiClear" title="Clear conversation" aria-label="Clear conversation">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>
                </button>
                <button type="button" id="ekAiClose" title="Close" aria-label="Close assistant">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
        </div>
        <div id="ekAiMessages" class="ek-ai-messages" aria-live="polite"></div>
        <form id="ekAiForm" class="ek-ai-inputrow" autocomplete="off">
            <input type="text" id="ekAiInput" maxlength="2000" placeholder="e.g. I have NPR 20,000 for a wedding…" aria-label="Message the assistant">
            <button type="submit" id="ekAiSend" aria-label="Send">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
            </button>
        </form>
    </div>
</div>
<script src="/js/ai-chat.js"></script>
