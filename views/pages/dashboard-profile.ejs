<%- include('../partials/dashboard-wrapper-start') %>

<div class="page-header mb-4">
    <h1 class="font-display fs-2 fw-bold mb-1">Edit Profile</h1>
    <p class="text-muted">This information will be displayed on your <a href="/profile/<%= currentUser.id %>" class="link" target="_blank" rel="noopener noreferrer">public profile <i class="bi bi-box-arrow-up-right small"></i></a></p>
</div>

<form method="POST" action="/dashboard/profile" enctype="multipart/form-data">

    <!-- Avatar & Cover -->
    <div class="profile-section">
        <div class="profile-section__label">
            <h3>Visual Identity</h3>
            <p>Your profile and cover photos are the first things clients see.</p>
        </div>
        <div>
            <div class="avatar-row mb-4">
                <div class="avatar-preview" id="avatar-preview">
                    <img src="<%= currentUser.avatar_url || '/images/default-avatar.png' %>" alt="Avatar" id="avatar-img">
                </div>
                <div class="avatar-controls">
                    <label class="btn btn-outline-sm d-inline-flex align-items-center gap-2" style="cursor:pointer">
                        <i class="bi bi-camera"></i> Change Photo
                        <input type="file" name="avatar" accept="image/*" hidden onchange="previewAvatar(this)">
                    </label>
                    <span class="form-hint">JPG, PNG · Max 5MB</span>
                </div>
            </div>
            <div class="cover-preview overflow-hidden" id="cover-preview"
                 style="<%= currentUser.cover_photo_url ? 'background-image:url('+currentUser.cover_photo_url+')' : '' %>">
                <input type="file" name="cover" accept="image/*" onchange="previewCover(this)">
                <div class="cover-btn"><i class="bi bi-image"></i> Upload Cover Image</div>
            </div>
        </div>
    </div>

    <!-- Basic Info -->
    <div class="profile-section">
        <div class="profile-section__label">
            <h3>Personal Details</h3>
            <p>Basic information to identify you on the platform.</p>
        </div>
        <div>
            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">First Name <span class="req">*</span></label>
                    <input class="form-control form-input" type="text" name="first_name" value="<%= currentUser.first_name || '' %>" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Last Name <span class="req">*</span></label>
                    <input class="form-control form-input" type="text" name="last_name" value="<%= currentUser.last_name || '' %>" required>
                </div>
            </div>

            <% if (currentUser.role === 'worker') { %>
                <div class="form-group">
                    <label class="form-label">Professional Tagline</label>
                    <input class="form-control form-input" type="text" name="tagline" value="<%= currentUser.tagline || '' %>"
                           placeholder="e.g. Expert Wedding Photographer" maxlength="120">
                    <span class="form-hint">A catchy one-liner about your services.</span>
                </div>
            <% } %>

            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">City <span class="req">*</span></label>
                    <input class="form-control form-input" type="text" name="city" value="<%= currentUser.city || '' %>" placeholder="e.g. Kathmandu" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Address</label>
                    <input class="form-control form-input" type="text" name="address" value="<%= currentUser.address || '' %>" placeholder="e.g. Thamel, Ward 26">
                </div>
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">Date of Birth</label>
                    <input class="form-control form-input" type="date" name="date_of_birth"
                           value="<%= currentUser.date_of_birth ? new Date(currentUser.date_of_birth).toISOString().split('T')[0] : '' %>">
                </div>
                <div class="form-group">
                    <label class="form-label">Gender</label>
                    <select class="form-select form-input" name="gender">
                        <option value="">Select Gender</option>
                        <option value="male" <%= currentUser.gender === 'male' ? 'selected' : '' %>>Male</option>
                        <option value="female" <%= currentUser.gender === 'female' ? 'selected' : '' %>>Female</option>
                        <option value="other" <%= currentUser.gender === 'other' ? 'selected' : '' %>>Other</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Bio -->
    <div class="profile-section">
        <div class="profile-section__label">
            <h3>About You</h3>
            <p>Tell your story and showcase your expertise.</p>
        </div>
        <div>
            <div class="form-group">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label mb-0">Professional Bio <% if (currentUser.role === 'worker') { %><span class="req">*</span><% } %></label>
                    <span class="form-hint fw-bold" id="bio-count">0 words</span>
                </div>
                <textarea class="form-control form-input form-textarea" name="bio" id="bio-textarea"
                          placeholder="Describe your services, experience, and style..."
                          oninput="updateBioCount()"><%= currentUser.bio || '' %></textarea>
                <span class="form-hint">Workers need at least 50 words to publish services.</span>
            </div>
        </div>
    </div>

    <!-- Skills -->
    <% if (currentUser.role === 'worker') { %>
        <div class="profile-section">
            <div class="profile-section__label">
                <h3>Expertise & Skills</h3>
                <p>Add keywords that help clients find you in search.</p>
            </div>
            <div>
                <div class="form-group">
                    <div class="skills-wrap" id="skills-wrap">
                        <% if (currentUser.skills && currentUser.skills.length > 0) { %>
                            <% currentUser.skills.forEach(function(skill) { %>
                                <span class="skill-chip">
                                    <%= skill %>
                                    <button type="button" class="skill-chip__rm" onclick="removeSkill(this)">×</button>
                                    <input type="hidden" name="skills[]" value="<%= skill %>">
                                </span>
                            <% }) %>
                        <% } %>
                        <input type="text" class="skills-input" id="skill-input"
                               placeholder="Add a skill..." onkeydown="addSkill(event)">
                    </div>
                    <span class="form-hint">Press Enter or use a comma to add a skill. Max 15.</span>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Previous Works -->
    <% if (currentUser.role === 'worker') { %>
        <div class="profile-section">
            <div class="profile-section__label">
                <h3>Previous Works</h3>
                <p>Showcase photos of your past work. These appear on your public profile above your services.</p>
            </div>
            <div>
                <% if (portfolio && portfolio.length > 0) { %>
                    <div class="portfolio-grid mb-3">
                        <% portfolio.forEach(function(item) { %>
                            <div class="portfolio-thumb">
                                <img src="<%= item.image_url %>" alt="Previous work">
                                <button type="submit" class="portfolio-thumb__rm"
                                        formaction="/dashboard/portfolio/<%= item.id %>/delete"
                                        formmethod="POST" formnovalidate
                                        title="Remove image">×</button>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
                <div class="form-group mb-0">
                    <label class="btn btn-outline-sm d-inline-flex align-items-center gap-2" style="cursor:pointer">
                        <i class="bi bi-images"></i> Add Photos
                        <input type="file" name="portfolio" accept="image/*" multiple hidden>
                    </label>
                    <span class="form-hint">JPG, PNG · Max 5MB each · Up to 10 at a time. Saved when you click Save Profile.</span>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Socials -->
    <div class="profile-section border-0">
        <div class="profile-section__label">
            <h3>Online Presence</h3>
            <p>Links to your social media or personal website.</p>
        </div>
        <div>
            <% const social = (currentUser.social_links && typeof currentUser.social_links === 'object') ? currentUser.social_links : {}; %>
            <div class="form-group">
                <label class="form-label">Instagram</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0 small">instagram.com/</span>
                    <input class="form-control form-input border-start-0" type="text" name="instagram" value="<%= social.instagram || '' %>" placeholder="username">
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Facebook</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0 small">facebook.com/</span>
                    <input class="form-control form-input border-start-0" type="text" name="facebook" value="<%= social.facebook || '' %>" placeholder="username">
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Website</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0 small"><i class="bi bi-link-45deg"></i></span>
                    <input class="form-control form-input border-start-0" type="url" name="website" value="<%= social.website || '' %>" placeholder="https://yoursite.com">
                </div>
            </div>
        </div>
    </div>

    <div class="profile-form-footer pt-4 pb-5">
        <a href="/dashboard" class="btn btn-outline px-4">Discard Changes</a>
        <button type="submit" class="btn btn-primary px-5">Save Profile</button>
    </div>

</form>

<script>
function updateBioCount() {
    const words = document.getElementById('bio-textarea').value.trim().split(/\s+/).filter(Boolean).length;
    const counter = document.getElementById('bio-count');
    counter.textContent = words + ' words';
    counter.style.color = (words < 50 && '<%= currentUser.role %>' === 'worker') ? 'var(--ek-maroon)' : 'inherit';
}
updateBioCount();

function previewAvatar(input) {
    if (!input.files[0]) return;
    const r = new FileReader();
    r.onload = (e) => { document.getElementById('avatar-img').src = e.target.result; };
    r.readAsDataURL(input.files[0]);
}

function previewCover(input) {
    if (!input.files[0]) return;
    const r = new FileReader();
    r.onload = (e) => { document.getElementById('cover-preview').style.backgroundImage = `url(${e.target.result})`; };
    r.readAsDataURL(input.files[0]);
}

function addSkill(e) {
    if (!['Enter', ','].includes(e.key)) return;
    e.preventDefault();
    const input = document.getElementById('skill-input');
    const val = input.value.trim().replace(/,$/,'');
    if (!val) return;
    const wrap = document.getElementById('skills-wrap');
    if (wrap.querySelectorAll('.skill-chip').length >= 15) return;
    
    const chip = document.createElement('span');
    chip.className = 'skill-chip';
    chip.innerHTML = `${val.replace(/</g,'&lt;')}
        <button type="button" class="skill-chip__rm" onclick="removeSkill(this)">×</button>
        <input type="hidden" name="skills[]" value="${val.replace(/"/g,'&quot;')}">`;
    wrap.insertBefore(chip, input);
    input.value = '';
}
function removeSkill(btn) { btn.parentElement.remove(); }
</script>

<%- include('../partials/dashboard-wrapper-end') %>
