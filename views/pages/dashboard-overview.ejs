<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.pageTitle || 'Dashboard' %> — EventKraft</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/topnav.css">
  <link rel="stylesheet" href="/css/sidebar.css">
  <link rel="stylesheet" href="/css/forms.css">
  <style>
    .dash-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 32px; }
    .dash-stat { background: #fff; border: 1px solid #E4E7EC; border-radius: 14px; padding: 20px; }
    .dash-stat__label { font-size: 13px; color: #667085; margin: 0 0 6px; }
    .dash-stat__value { font-size: 28px; font-weight: 800; color: #101828; margin: 0; }
    .dash-section { margin-bottom: 32px; }
    .dash-section__title { font-size: 16px; font-weight: 700; color: #101828; margin: 0 0 14px; display: flex; align-items: center; gap: 8px; }
    .dash-table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid #E4E7EC; border-radius: 12px; overflow: hidden; }
    .dash-table th { font-size: 12px; font-weight: 600; color: #667085; text-transform: uppercase; letter-spacing: .04em; padding: 10px 14px; border-bottom: 1px solid #E4E7EC; text-align: left; }
    .dash-table td { padding: 12px 14px; font-size: 14px; color: #344054; border-bottom: 1px solid #F2F4F7; }
    .dash-table tr:last-child td { border-bottom: none; }
    .dash-table a { color: #3538CD; text-decoration: none; font-weight: 600; }
    .dash-table a:hover { text-decoration: underline; }
    .badge-status { font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 100px; }
    .badge-open, .badge-active { background: #ECFDF3; color: #027A48; }
    .badge-pending { background: #FFFAEB; color: #B54708; }
    .badge-completed { background: #EEF4FF; color: #3538CD; }
    .badge-cancelled { background: #FEF3F2; color: #B42318; }
    .empty-box { background: #F9FAFB; border: 1px solid #E4E7EC; border-radius: 12px; padding: 40px; text-align: center; color: #667085; font-size: 14px; }
    .empty-box a { color: #3538CD; font-weight: 600; text-decoration: none; }
  </style>
</head>
<body class="dashboard-body">

  <%- include('../partials/topnav') %>

  <div class="dashboard-shell">
    <%- include('../partials/sidebar') %>

    <main class="dashboard-main">
      <div class="dashboard-main__inner">

        <!-- Flash -->
        <% if (locals.success && success.length > 0) { %>
          <% success.forEach(function(msg) { %><div class="flash flash--success"><%= msg %></div><% }) %>
        <% } %>
        <% if (locals.error && error.length > 0) { %>
          <% error.forEach(function(msg) { %><div class="flash flash--error"><%= msg %></div><% }) %>
        <% } %>

        <div class="page-header">
          <h1 class="page-title">Welcome back, <%= currentUser.first_name || 'there' %> 👋</h1>
          <p class="page-desc">Here's what's happening with your account.</p>
        </div>

        <% if (currentUser.role === 'customer') { %>
          <!-- Customer Stats -->
          <div class="dash-stats">
            <div class="dash-stat">
              <p class="dash-stat__label">Active Jobs</p>
              <p class="dash-stat__value"><%= stats.active_jobs || 0 %></p>
            </div>
            <div class="dash-stat">
              <p class="dash-stat__label">Pending Proposals</p>
              <p class="dash-stat__value"><%= stats.pending_proposals || 0 %></p>
            </div>
            <div class="dash-stat">
              <p class="dash-stat__label">Total Bookings</p>
              <p class="dash-stat__value"><%= stats.total_bookings || 0 %></p>
            </div>
            <div class="dash-stat">
              <p class="dash-stat__label">Total Spent</p>
              <p class="dash-stat__value">NPR <%= Number(stats.total_spent || 0).toLocaleString('en-IN') %></p>
            </div>
          </div>

          <div class="dash-section">
            <h3 class="dash-section__title">Your Active Jobs</h3>
            <% if (jobs && jobs.length > 0) { %>
              <table class="dash-table">
                <thead><tr><th>Title</th><th>Category</th><th>Proposals</th><th>Status</th><th></th></tr></thead>
                <tbody>
                  <% jobs.forEach(function(j) { %>
                    <tr>
                      <td><a href="/jobs/<%= j.id %>"><%= j.title %></a></td>
                      <td><%= j.category_name || '-' %></td>
                      <td><%= j.proposal_count || 0 %></td>
                      <td><span class="badge-status badge-<%= j.status %>"><%= j.status %></span></td>
                      <td><a href="/jobs/<%= j.id %>">View</a></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            <% } else { %>
              <div class="empty-box">No jobs posted yet. <a href="/jobs/create">Post your first job!</a></div>
            <% } %>
          </div>

          <div class="dash-section">
            <h3 class="dash-section__title">Recent Bookings</h3>
            <% if (bookings && bookings.length > 0) { %>
              <table class="dash-table">
                <thead><tr><th>Service</th><th>Worker</th><th>Status</th><th></th></tr></thead>
                <tbody>
                  <% bookings.forEach(function(b) { %>
                    <tr>
                      <td><%= b.gig_title || 'Booking' %></td>
                      <td><%= b.worker_name || '-' %></td>
                      <td><span class="badge-status badge-<%= b.status %>"><%= b.status %></span></td>
                      <td><a href="/bookings/<%= b.id %>">View</a></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            <% } else { %>
              <div class="empty-box">No bookings yet. <a href="/gigs">Browse services</a> to get started!</div>
            <% } %>
          </div>

        <% } else if (currentUser.role === 'worker') { %>
          <!-- Worker Stats -->
          <div class="dash-stats">
            <div class="dash-stat">
              <p class="dash-stat__label">Active Services</p>
              <p class="dash-stat__value"><%= stats.active_gigs || 0 %></p>
            </div>
            <div class="dash-stat">
              <p class="dash-stat__label">Pending Bookings</p>
              <p class="dash-stat__value"><%= stats.pending_bookings || 0 %></p>
            </div>
            <div class="dash-stat">
              <p class="dash-stat__label">Completed</p>
              <p class="dash-stat__value"><%= stats.completed || 0 %></p>
            </div>
            <div class="dash-stat">
              <p class="dash-stat__label">Total Earned</p>
              <p class="dash-stat__value">NPR <%= Number(stats.total_earned || 0).toLocaleString('en-IN') %></p>
            </div>
          </div>

          <div class="dash-section">
            <h3 class="dash-section__title">Your Services</h3>
            <% if (gigs && gigs.length > 0) { %>
              <table class="dash-table">
                <thead><tr><th>Title</th><th>Category</th><th>Status</th><th></th></tr></thead>
                <tbody>
                  <% gigs.forEach(function(g) { %>
                    <tr>
                      <td><a href="/gigs/<%= g.id %>"><%= g.title %></a></td>
                      <td><%= g.category_name || '-' %></td>
                      <td><span class="badge-status badge-<%= g.status %>"><%= g.status %></span></td>
                      <td><a href="/gigs/<%= g.id %>/edit">Edit</a></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            <% } else { %>
              <div class="empty-box">No services created yet. <a href="/gigs/create">Create your first service!</a></div>
            <% } %>
          </div>

        <% } else { %>
          <!-- Admin -->
          <div class="dash-stats">
            <div class="dash-stat">
              <p class="dash-stat__label">Welcome</p>
              <p class="dash-stat__value">Admin</p>
            </div>
          </div>
          <div class="empty-box"><a href="/admin">Go to Admin Panel</a></div>
        <% } %>

      </div>
    </main>
  </div>

</body>
</html>
