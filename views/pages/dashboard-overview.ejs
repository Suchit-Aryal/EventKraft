<%- include('../partials/dashboard-wrapper-start') %>

<div class="page-header mb-4">
    <h1 class="font-display fs-2 fw-bold mb-1">Welcome back, <%= currentUser.first_name || 'there' %></h1>
    <p class="text-muted">Here's a summary of your activity on EventKraft.</p>
</div>

<% const pc = locals.profileCompletion || { percentage: 100, steps: [] }; %>
<% const pcPercentage = Math.max(0, Math.min(100, Math.round(Number(pc.percentage) || 0))); %>
<% if (pcPercentage < 100) { %>
    <% const incompleteSteps = (pc.steps || []).filter(step => !step.done); %>
    <div class="profile-completion-card profile-completion-card--compact mb-4" id="profileCompletionCard">
        <div class="profile-completion-card__summary">
            <div style="flex:1;min-width:0">
                <p class="profile-completion-card__eyebrow">Profile strength — <%= pcPercentage %>%</p>
                <div class="profile-completion-card__track" style="margin:8px 0 0">
                    <div style="width:<%= pcPercentage %>%"></div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <% if (incompleteSteps.length > 0) { %>
                    <a href="<%= incompleteSteps[0].href %>" class="btn btn-ek-primary btn-sm">Complete profile</a>
                <% } %>
                <button type="button" class="btn btn-sm btn-outline-secondary" style="padding:2px 8px;line-height:1;font-size:1rem;border-radius:8px" onclick="dismissProfileCard()" title="Dismiss">&times;</button>
            </div>
        </div>

        <div class="profile-completion-grid profile-completion-grid--compact mt-3">
            <% incompleteSteps.slice(0, 3).forEach(function(step) { %>
                <a href="<%= step.href %>" class="profile-completion-task">
                    <span class="profile-completion-task__check">
                        <i class="bi bi-circle"></i>
                    </span>
                    <div>
                        <strong><%= step.label %></strong>
                    </div>
                    <em>+<%= step.impact ?? step.points ?? 0 %>%</em>
                </a>
            <% }); %>
        </div>
    </div>

    <script>
    (function() {
        if (sessionStorage.getItem('ek-dismiss-profile-card')) {
            var el = document.getElementById('profileCompletionCard');
            if (el) el.style.display = 'none';
        }
    })();
    function dismissProfileCard() {
        var el = document.getElementById('profileCompletionCard');
        if (el) el.style.display = 'none';
        sessionStorage.setItem('ek-dismiss-profile-card', '1');
    }
    </script>
<% } %>

<% if (currentUser.role === 'customer') { %>
    <!-- Customer Stats -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-maroon"><i class="bi bi-megaphone"></i></div>
                <div class="stat-value text-dark"><%= stats.active_jobs || 0 %></div>
                <div class="stat-label">Active Jobs</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-orange"><i class="bi bi-envelope-paper"></i></div>
                <div class="stat-value text-dark"><%= stats.pending_proposals || 0 %></div>
                <div class="stat-label">Proposals</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-green"><i class="bi bi-calendar-check"></i></div>
                <div class="stat-value text-dark"><%= stats.total_bookings || 0 %></div>
                <div class="stat-label">Total Bookings</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-blue"><i class="bi bi-wallet2"></i></div>
                <div class="stat-value text-dark">NPR <%= Number(stats.total_spent || 0).toLocaleString() %></div>
                <div class="stat-label">Total Spent</div>
            </div>
        </div>
    </div>

    <% if (locals.recommendations && recommendations.length > 0) { %>
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-stars text-warning me-1"></i>Recommended for you</h5>
                <a href="/gigs" class="text-decoration-none small fw-semibold">Browse all</a>
            </div>
            <div class="ek-rec-row">
                <% recommendations.forEach(function(g) {
                    let img = null;
                    try {
                        const imgs = typeof g.portfolio_images === 'string' ? JSON.parse(g.portfolio_images) : g.portfolio_images;
                        img = Array.isArray(imgs) && imgs.length > 0 ? imgs[0] : null;
                    } catch (e) {}
                %>
                    <a href="/gigs/<%= g.id %>" class="ek-rec-card">
                        <div class="ek-rec-card__img">
                            <% if (img) { %><img src="<%= img %>" alt="" loading="lazy"><% } %>
                        </div>
                        <div class="ek-rec-card__body">
                            <span class="badge bg-light text-dark mb-1"><%= g.category_name || 'Service' %></span>
                            <div class="ek-rec-card__title"><%= g.title %></div>
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2">
                                <span class="text-success fw-bold small">From NPR <%= Number(g.starting_price).toLocaleString() %></span>
                                <% if (g.worker_rating) { %>
                                    <span class="small text-muted"><i class="bi bi-star-fill text-warning"></i> <%= Number(g.worker_rating).toFixed(1) %></span>
                                <% } %>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>
        </div>
    <% } %>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Active Job Postings</h5>
                <a href="/jobs" class="text-decoration-none small fw-semibold">View all</a>
            </div>
            <% if (jobs && jobs.length > 0) { %>
                <div class="crm-table">
                    <table class="table">
                        <thead><tr><th>Title</th><th>Proposals</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            <% jobs.forEach(function(j) { %>
                                <tr>
                                    <td><a href="/jobs/<%= j.id %>" class="fw-semibold text-dark text-decoration-none"><%= j.title %></a></td>
                                    <td><span class="badge bg-light text-dark rounded-pill px-3"><%= j.proposal_count || 0 %></span></td>
                                    <td><span class="badge-status badge-<%= j.status %>"><%= j.status %></span></td>
                                    <td>
                                        <% if (j.status === 'draft') { %>
                                            <form action="/jobs/<%= j.id %>/publish" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-circle"></i> Publish</button>
                                            </form>
                                        <% } %>
                                        <a href="/jobs/<%= j.id %>" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i> Edit</a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="bi bi-file-earmark-plus"></i>
                    <p>No active jobs found.</p>
                    <a href="/jobs/create" class="btn btn-ek-gold btn-sm">Post a Job</a>
                </div>
            <% } %>
        </div>
        <div class="col-lg-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Recent Bookings</h5>
                <a href="/bookings" class="text-decoration-none small fw-semibold">History</a>
            </div>
            <% if (bookings && bookings.length > 0) { %>
                <div class="list-group list-group-flush border rounded-4 overflow-hidden">
                    <% bookings.forEach(function(b) { %>
                        <a href="/bookings/<%= b.id %>" class="list-group-item list-group-item-action p-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold small text-dark"><%= b.gig_title || 'Service Booking' %></span>
                                <span class="badge-status badge-<%= b.status %>" style="font-size: 0.65rem;"><%= b.status %></span>
                            </div>
                            <div class="text-muted" style="font-size: 0.75rem;">with <%= b.worker_name %></div>
                        </a>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state py-4">
                    <p class="mb-0">No bookings yet.</p>
                </div>
            <% } %>
        </div>
    </div>

<% } else if (currentUser.role === 'worker') { %>
    <!-- Worker Stats -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-maroon"><i class="bi bi-shop"></i></div>
                <div class="stat-value text-dark"><%= stats.active_gigs || 0 %></div>
                <div class="stat-label">Active Gigs</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-orange"><i class="bi bi-clock-history"></i></div>
                <div class="stat-value text-dark"><%= stats.pending_bookings || 0 %></div>
                <div class="stat-label">Pending Orders</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-green"><i class="bi bi-check-circle"></i></div>
                <div class="stat-value text-dark"><%= stats.completed || 0 %></div>
                <div class="stat-label">Completed</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-blue"><i class="bi bi-currency-dollar"></i></div>
                <div class="stat-value text-dark">NPR <%= Number(stats.total_earned || 0).toLocaleString() %></div>
                <div class="stat-label">Earnings</div>
            </div>
        </div>
    </div>

    <% if (locals.recommendations && recommendations.length > 0) { %>
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-stars text-warning me-1"></i>Jobs you might like</h5>
                <a href="/jobs" class="text-decoration-none small fw-semibold">Browse all</a>
            </div>
            <div class="ek-rec-row">
                <% recommendations.forEach(function(j) { %>
                    <a href="/jobs/<%= j.id %>" class="ek-rec-card ek-rec-card--job">
                        <div class="ek-rec-card__body">
                            <span class="badge bg-light text-dark mb-1"><%= j.category_name || 'Event' %></span>
                            <div class="ek-rec-card__title"><%= j.title %></div>
                            <% if (j.event_location) { %>
                                <div class="small text-muted text-truncate mt-1"><i class="bi bi-geo-alt"></i> <%= j.event_location %></div>
                            <% } %>
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2">
                                <% if (j.budget_min || j.budget_max) { %>
                                    <span class="text-success fw-bold small">NPR <%= Number(j.budget_min || 0).toLocaleString() %><% if (j.budget_max) { %>–<%= Number(j.budget_max).toLocaleString() %><% } %></span>
                                <% } else { %>
                                    <span class="small text-muted">Budget open</span>
                                <% } %>
                                <% if (j.event_date) { %>
                                    <span class="small text-muted"><%= new Date(j.event_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %></span>
                                <% } %>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>
        </div>
    <% } %>

    <div class="row g-4">
        <div class="col-lg-8">
            <h5 class="fw-bold mb-3">Your Published Services</h5>
            <% if (gigs && gigs.length > 0) { %>
                <div class="row g-3">
                    <% gigs.forEach(function(g) { %>
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="badge bg-light text-dark"><%= g.category_name %></div>
                                        <span class="badge-status badge-<%= g.status %>"><%= g.status %></span>
                                    </div>
                                    <h6 class="fw-bold mb-2"><a href="/gigs/<%= g.id %>" class="text-dark text-decoration-none"><%= g.title %></a></h6>
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <span class="text-success fw-bold small">From NPR <%= Number(g.starting_price).toLocaleString() %></span>
                                        <div class="d-flex gap-1">
                                            <% if (g.status === 'draft') { %>
                                                <form action="/gigs/<%= g.id %>/publish" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-circle"></i> Publish</button>
                                                </form>
                                            <% } %>
                                            <a href="/gigs/<%= g.id %>/edit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil"></i></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="bi bi-plus-circle"></i>
                    <p>You haven't listed any services yet.</p>
                    <a href="/gigs/create" class="btn btn-ek-primary btn-sm">Create a Service</a>
                </div>
            <% } %>
        </div>
        <div class="col-lg-4">
            <h5 class="fw-bold mb-3">Quick Actions</h5>
            <div class="d-grid gap-2">
                <a href="/gigs/create" class="quick-action">
                    <div class="qa-icon bg-maroon text-white"><i class="bi bi-plus-lg"></i></div>
                    <div><div class="fw-bold small">New Service</div><div class="text-muted" style="font-size:0.7rem">List a new gig</div></div>
                </a>
                <a href="/messages" class="quick-action">
                    <div class="qa-icon bg-orange text-white"><i class="bi bi-chat-text"></i></div>
                    <div><div class="fw-bold small">Check Messages</div><div class="text-muted" style="font-size:0.7rem">Reply to enquiries</div></div>
                </a>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
                <h5 class="fw-bold mb-0">Recent Orders</h5>
                <a href="/bookings" class="text-decoration-none small fw-semibold">History</a>
            </div>
            <% if (bookings && bookings.length > 0) { %>
                <div class="list-group list-group-flush border rounded-4 overflow-hidden">
                    <% bookings.forEach(function(b) { %>
                        <a href="/bookings/<%= b.id %>" class="list-group-item list-group-item-action p-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold small text-dark text-truncate me-2"><%= b.gig_title || 'Service Booking' %></span>
                                <span class="badge-status badge-<%= b.status %>" style="font-size: 0.65rem;"><%= b.status %></span>
                            </div>
                            <div class="text-muted" style="font-size: 0.75rem;">for <%= b.customer_name %></div>
                        </a>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state py-4">
                    <p class="mb-0">No orders yet.</p>
                </div>
            <% } %>
        </div>
    </div>
<% } %>

<%- include('../partials/dashboard-wrapper-end') %>
