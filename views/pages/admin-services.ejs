<%- include('../partials/dashboard-wrapper-start') %>

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
        <a href="/admin" class="text-decoration-none text-muted"><i class="bi bi-arrow-left"></i></a>
        <h1 class="font-display fs-3 fw-semibold mb-0">Manage Services</h1>
        <span class="text-muted">(<%= gigs.length %> total)</span>
    </div>

    <form action="/admin/services" method="GET" class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex flex-wrap gap-3 align-items-end">
            <div>
                <label class="form-label small fw-semibold text-muted mb-1">Search</label>
                <input type="text" name="keyword" class="form-control form-control-sm" placeholder="Title, worker name or email..." value="<%= filters.keyword %>">
            </div>
            <div>
                <label class="form-label small fw-semibold text-muted mb-1">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
                    <option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>>Draft</option>
                    <option value="paused" <%= filters.status === 'paused' ? 'selected' : '' %>>Paused</option>
                </select>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm">Filter</button>
                <a href="/admin/services" class="btn btn-outline-secondary btn-sm">Clear</a>
            </div>
        </div>
    </form>

    <% if (gigs.length > 0) { %>
        <div class="crm-table">
            <table class="table">
                <thead>
                    <tr>
                        <th>Service</th>
                        <th>Worker</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <% gigs.forEach(function(g) { %>
                        <tr>
                            <td>
                                <a href="/gigs/<%= g.id %>" class="fw-semibold text-decoration-none" target="_blank" rel="noopener noreferrer"><%= g.title %></a>
                            </td>
                            <td>
                                <div><%= g.worker_first_name || '' %> <%= g.worker_last_name || '' %></div>
                                <div class="text-muted small"><%= g.worker_email %></div>
                            </td>
                            <td><span class="ek-badge ek-badge-category"><%= g.category_name || '-' %></span></td>
                            <td class="fw-semibold">NPR <%= Number(g.starting_price || 0).toLocaleString('en-IN') %></td>
                            <td><span class="badge-status badge-<%= g.status %>"><%= g.status %></span></td>
                            <td class="text-muted small"><%= new Date(g.created_at).toLocaleDateString('en-GB', {day:'numeric', month:'short', year:'numeric'}) %></td>
                            <td>
                                <form action="/admin/services/<%= g.id %>?_method=PUT" method="POST" class="d-flex gap-1">
                                    <input type="hidden" name="_method" value="PUT">
                                    <% if (g.status === 'active') { %>
                                        <input type="hidden" name="status" value="paused">
                                        <button type="submit" class="btn btn-sm btn-outline-warning" title="Pause this service"><i class="bi bi-pause-circle"></i></button>
                                    <% } else { %>
                                        <input type="hidden" name="status" value="active">
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Activate this service"><i class="bi bi-play-circle"></i></button>
                                    <% } %>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="empty-state text-center py-5">
            <i class="bi bi-shop fs-1 text-muted"></i>
            <p class="mt-2 text-muted">No services found.</p>
        </div>
    <% } %>
</div>

<%- include('../partials/dashboard-wrapper-end') %>
