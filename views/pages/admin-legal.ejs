<%- include('../partials/dashboard-wrapper-start') %>

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
        <a href="/admin" class="text-decoration-none text-muted"><i class="bi bi-arrow-left"></i></a>
        <h1 class="font-display fs-3 fw-semibold mb-0">Legal Action Panel</h1>
        <span class="badge bg-danger text-white"><%= bookings.length %> flagged</span>
    </div>

    <% if (bookings.length === 0) { %>
        <div class="ek-card text-center py-5">
            <i class="bi bi-shield-check fs-1 text-success mb-3 d-block"></i>
            <p class="text-muted">No overdue or legal action bookings. All clear.</p>
        </div>
    <% } else { %>
        <% bookings.forEach(function(b) { %>
        <div class="ek-card mb-4" style="border-left: 4px solid #dc3545; padding: 1.5rem 2rem;">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                <div>
                    <span class="badge bg-danger mb-1"><%= b.status.replace('_', ' ').toUpperCase() %></span>
                    <h5 class="fw-semibold mb-0"><%= b.gig_title_full || b.gig_title || 'Booking #' + String(b.id).slice(0,8) %></h5>
                </div>
                <div class="d-flex gap-2">
                    <% if (b.status === 'overdue_final') { %>
                    <form action="/admin/bookings/<%= b.id %>/legal-action" method="POST" style="display:inline">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Mark this booking for legal action?')">
                            <i class="bi bi-file-earmark-lock me-1"></i> Mark Legal Action
                        </button>
                    </form>
                    <% } %>
                    <form action="/admin/bookings/<%= b.id %>/resolve" method="POST" style="display:inline">
                        <button type="submit" class="btn btn-outline-success btn-sm" onclick="return confirm('Mark this booking as resolved?')">
                            <i class="bi bi-check-circle me-1"></i> Mark Resolved
                        </button>
                    </form>
                </div>
            </div>

            <div class="row g-3">
                <!-- Customer Info -->
                <div class="col-md-4">
                    <h6 class="text-muted small fw-semibold text-uppercase mb-2">Customer</h6>
                    <p class="mb-1 fw-semibold"><%= b.customer_name %></p>
                    <p class="mb-1 small"><i class="bi bi-envelope me-1"></i><%= b.customer_email %></p>
                    <% if (b.customer_phone) { %>
                    <p class="mb-1 small"><i class="bi bi-telephone me-1"></i><%= b.customer_phone %></p>
                    <% } %>
                    <% if (b.customer_ip) { %>
                    <p class="mb-0 small text-muted"><i class="bi bi-geo me-1"></i>IP: <code><%= b.customer_ip %></code></p>
                    <% } %>
                </div>

                <!-- Booking Details -->
                <div class="col-md-4">
                    <h6 class="text-muted small fw-semibold text-uppercase mb-2">Booking Details</h6>
                    <p class="mb-1 small"><strong>Worker:</strong> <%= b.worker_name %></p>
                    <p class="mb-1 small"><strong>Total Owed:</strong> <span class="text-danger fw-semibold">NPR <%= Number(b.final_amount || b.total_amount * 0.70).toLocaleString('en-IN') %></span></p>
                    <% if (b.event_date) { %>
                    <p class="mb-1 small"><strong>Event Date:</strong> <%= new Date(b.event_date).toLocaleDateString('en-GB') %></p>
                    <% } %>
                    <% if (b.overdue_flagged_at) { %>
                    <p class="mb-0 small text-danger"><strong>Flagged:</strong> <%= new Date(b.overdue_flagged_at).toLocaleString('en-GB') %></p>
                    <% } %>
                </div>

                <!-- Legal Evidence -->
                <div class="col-md-4">
                    <h6 class="text-muted small fw-semibold text-uppercase mb-2">Legal Evidence</h6>
                    <% if (b.agreement_timestamp) { %>
                    <p class="mb-1 small"><strong>Agreed at:</strong> <%= new Date(b.agreement_timestamp).toLocaleString('en-GB') %></p>
                    <% } %>
                    <% if (b.agreement_version) { %>
                    <p class="mb-1 small"><strong>Agreement:</strong> v<%= b.agreement_version %></p>
                    <% } %>
                    <% if (b.customer_ip) { %>
                    <p class="mb-1 small"><strong>IP at agreement:</strong> <code><%= b.customer_ip %></code></p>
                    <% } %>
                    <a href="/bookings/<%= b.id %>" class="btn btn-outline-secondary btn-sm mt-1" target="_blank" rel="noopener noreferrer">
                        View Full Booking
                    </a>
                </div>
            </div>

            <!-- Work Proof Links -->
            <%
                let proofItems = [];
                try {
                    proofItems = typeof b.completion_proof === 'string'
                        ? JSON.parse(b.completion_proof || '[]')
                        : (b.completion_proof || []);
                } catch (err) {
                    proofItems = [];
                }
                if (!Array.isArray(proofItems)) proofItems = [];
            %>
            <% if (proofItems.length) { %>
            <div class="mt-3 pt-3" style="border-top:1px solid var(--ek-border)">
                <h6 class="text-muted small fw-semibold text-uppercase mb-2">Work Proof</h6>
                <div class="d-flex flex-wrap gap-2">
                    <% proofItems.forEach(function(p) { %>
                        <a href="<%= p.url %>" target="_blank" rel="noopener noreferrer">
                            <img src="<%= p.url %>" style="width:80px;height:60px;object-fit:cover;border-radius:4px;" alt="proof">
                        </a>
                    <% }); %>
                </div>
            </div>
            <% } %>
        </div>
        <% }); %>
    <% } %>
</div>

<%- include('../partials/dashboard-wrapper-end') %>
