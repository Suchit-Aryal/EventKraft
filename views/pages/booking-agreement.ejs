<%- include('../partials/dashboard-wrapper-start') %>

<div class="container py-4" style="max-width:760px">
    <a href="/bookings/<%= booking.id %>" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> Back to booking
    </a>

    <h1 class="font-display fs-3 fw-semibold mb-4">Legal Agreement</h1>

    <!-- Booking Summary Card -->
    <div class="ek-card mb-4" style="padding:1.5rem 2rem">
        <h5 class="fw-semibold mb-3">Booking Summary</h5>
        <div class="row g-3">
            <div class="col-sm-6">
                <p class="text-muted small mb-1">Service</p>
                <p class="fw-semibold mb-0"><%= booking.gig_title || booking.job_title || 'Service Booking' %></p>
            </div>
            <% if (booking.event_date) { %>
            <div class="col-sm-6">
                <p class="text-muted small mb-1">Event Date</p>
                <p class="fw-semibold mb-0"><%= new Date(booking.event_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
            </div>
            <% } %>
            <% if (booking.event_location) { %>
            <div class="col-sm-6">
                <p class="text-muted small mb-1">Event Location</p>
                <p class="fw-semibold mb-0"><%= booking.event_location %></p>
            </div>
            <% } %>
            <div class="col-sm-6">
                <p class="text-muted small mb-1">Total Price</p>
                <p class="fw-semibold mb-0">NPR <%= Number(booking.total_amount || 0).toLocaleString('en-IN') %></p>
            </div>
            <div class="col-sm-6">
                <p class="text-muted small mb-1">Advance Payment (30%)</p>
                <p class="fw-semibold mb-0 text-warning">
                    NPR <%= Number(booking.advance_amount || parseFloat((booking.total_amount * 0.30).toFixed(2))).toLocaleString('en-IN') %>
                </p>
            </div>
            <div class="col-sm-6">
                <p class="text-muted small mb-1">Final Payment (70%)</p>
                <p class="fw-semibold mb-0">
                    NPR <%= Number(booking.final_amount || parseFloat((booking.total_amount * 0.70).toFixed(2))).toLocaleString('en-IN') %>
                </p>
            </div>
        </div>
    </div>

    <!-- Deadline Warning -->
    <% if (booking.advance_deadline) { %>
    <div class="alert alert-warning d-flex align-items-start gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill mt-1 flex-shrink-0"></i>
        <div>
            <strong>Payment deadline:</strong>
            You have until <strong><%= new Date(booking.advance_deadline).toLocaleString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></strong>
            to pay or this booking will be cancelled.
        </div>
    </div>
    <% } %>

    <!-- Agreement Text -->
    <div class="ek-card mb-4" style="padding:1.5rem 2rem">
        <h5 class="fw-semibold mb-3">Terms &amp; Conditions</h5>
        <div style="height:300px;overflow-y:scroll;border:1px solid #ccc;padding:16px;border-radius:6px;font-size:.9rem;line-height:1.7;color:var(--ek-text-muted,#555)">
            <%= agreement.text %>
        </div>
    </div>

    <!-- Agreement Form -->
    <form id="agreement-form" action="/bookings/<%= booking.id %>/agreement" method="POST">
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="agree-checkbox" name="agreed" value="1">
            <label class="form-check-label fw-semibold" for="agree-checkbox">
                I have read and agree to all terms above
            </label>
        </div>

        <button type="submit" id="proceed-btn" class="btn btn-ek-primary w-100 mb-2" disabled>
            I Agree and Proceed to Payment
        </button>

        <p class="text-center text-muted" style="font-size:.78rem">
            Your IP address and agreement timestamp will be recorded as legally admissible evidence.
        </p>
    </form>
</div>

<script>
  document.getElementById('agree-checkbox').addEventListener('change', function() {
    document.getElementById('proceed-btn').disabled = !this.checked;
  });
  document.getElementById('agreement-form').addEventListener('submit', function(e) {
    if (!document.getElementById('agree-checkbox').checked) {
      e.preventDefault();
      alert('Please read and accept the terms to proceed.');
    }
  });
</script>

<%- include('../partials/dashboard-wrapper-end') %>
