<% if (locals.layout === 'dashboard') { %>
<%- include('../partials/dashboard-wrapper-start') %>
<% } else { %>
<%- include('../partials/header') %>
<% } %>

<div class="container py-4">
    <div class="row g-4">
        <!-- Filter Sidebar -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm sticky-top" style="top: 2rem; z-index: 10;">
                <div class="card-body">
                    <h5 class="fw-bold mb-4">Filters</h5>
                    <form action="/gigs" method="GET" id="gigSearchForm">
                        <div class="mb-3">
                            <label for="keyword" class="form-label small fw-semibold text-muted">Search Keyword</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" class="form-control border-start-0 ps-0" id="keyword" name="keyword" 
                                    placeholder="e.g. Photography, Logo..." value="<%= filters.keyword %>">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="category_id" class="form-label small fw-semibold text-muted">Category</label>
                            <select class="form-select form-select-sm" id="category_id" name="category_id">
                                <option value="">All Categories</option>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat.id %>" <%= filters.category_id === String(cat.id) ? 'selected' : '' %>><%= cat.name %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-semibold text-muted">Price Range (NPR)</label>
                            <div class="d-flex gap-2 align-items-center">
                                <input type="number" class="form-control form-control-sm" name="minPrice" placeholder="Min" value="<%= filters.minPrice %>">
                                <span class="text-muted small">to</span>
                                <input type="number" class="form-control form-control-sm" name="maxPrice" placeholder="Max" value="<%= filters.maxPrice %>">
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="sortBy" class="form-label small fw-semibold text-muted">Sort By</label>
                            <select class="form-select form-select-sm" id="sortBy" name="sortBy">
                                <option value="newest" <%= filters.sortBy === 'newest' ? 'selected' : '' %>>Newest First</option>
                                <option value="price_low" <%= filters.sortBy === 'price_low' ? 'selected' : '' %>>Price: Low to High</option>
                                <option value="price_high" <%= filters.sortBy === 'price_high' ? 'selected' : '' %>>Price: High to Low</option>
                                <option value="rating" <%= filters.sortBy === 'rating' ? 'selected' : '' %>>Highest Rated</option>
                            </select>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-sm">Apply Filters</button>
                            <a href="/gigs" class="btn btn-outline-secondary btn-sm">Clear All</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">Services</h2>
                    <p class="text-muted small mb-0">
                        <% if (filters.keyword || filters.category_id) { %>
                            Showing results for <span class="text-dark fw-semibold">"<%= filters.keyword || 'selected category' %>"</span>
                        <% } else { %>
                            Discover the best talent for your event
                        <% } %>
                    </p>
                </div>
                <div class="text-muted small">
                    <span class="fw-bold text-dark"><%= gigs.length %></span> services found
                </div>
            </div>

            <% if (gigs && gigs.length > 0) { %>
                <div class="row g-4">
                    <% gigs.forEach(gig => { %>
                        <div class="col-md-6 col-xl-4">
                            <div class="card h-100 border-0 shadow-sm hover-lift">
                                <div class="position-relative">
                                    <% 
                                        let cardImages = [];
                                        try {
                                            if (Array.isArray(gig.portfolio_images)) {
                                                cardImages = gig.portfolio_images;
                                            } else if (typeof gig.portfolio_images === 'string') {
                                                cardImages = JSON.parse(gig.portfolio_images || '[]');
                                            }
                                        } catch(e) {}
                                    %>
                                    <a href="/gigs/<%= gig.id %>" class="text-decoration-none">
                                        <% if (cardImages.length > 0) { %>
                                            <img src="<%= cardImages[0] %>" class="card-img-top" alt="<%= gig.title %>" style="height: 200px; object-fit: cover;">
                                        <% } else { %>
                                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                                <i class="bi bi-image text-muted fs-1"></i>
                                            </div>
                                        <% } %>
                                    </a>
                                    <div class="position-absolute top-0 end-0 p-2">
                                        <span class="badge bg-white text-dark shadow-sm">
                                            <i class="bi bi-star-fill text-warning me-1"></i>
                                            <%= gig.worker_rating && Number(gig.worker_rating) > 0 ? Number(gig.worker_rating).toFixed(1) : 'New' %>
                                        </span>
                                    </div>
                                </div>
                                <div class="card-body d-flex flex-column" style="gap:0">
                                    <div class="d-flex align-items-center gap-2 mb-2" style="flex-shrink:0">
                                        <img src="<%= gig.worker_avatar || ('https://ui-avatars.com/api/?name='+(gig.worker_first_name||'U')+'&size=24&background=random') %>" class="rounded-circle border" width="24" height="24" alt="">
                                        <span class="text-muted small fw-medium text-truncate"><%= gig.worker_first_name %> <%= gig.worker_last_name %></span>
                                    </div>
                                    <h6 class="card-title fw-bold mb-0" style="word-break:break-word;overflow-wrap:break-word;line-height:1.4;flex:1">
                                        <a href="/gigs/<%= gig.id %>" class="text-dark text-decoration-none stretched-link">
                                            <%= gig.title %>
                                        </a>
                                    </h6>
                                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                        <span class="text-muted small">Starting at</span>
                                        <span class="fw-bold text-primary">NPR <%= Number(gig.starting_price).toLocaleString() %></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <img src="/images/no-results.svg" alt="No results" class="mb-4" style="max-width: 200px; opacity: 0.5;">
                        <h4>No services found</h4>
                        <p class="text-muted">Try adjusting your filters or search terms to find what you're looking for.</p>
                        <a href="/gigs" class="btn btn-primary btn-sm">Clear All Filters</a>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<style>
    .hover-lift { transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out; }
    .hover-lift:hover { transform: translateY(-5px); box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important; }
    .card-img-top { border-top-left-radius: calc(0.375rem - 1px); border-top-right-radius: calc(0.375rem - 1px); }
</style>

<!-- Autocomplete Logic stays similar but optimized for the new layout if needed -->
<script>
    (function () {
        const input = document.getElementById('keyword');
        if (!input) return;

        const dropdown = document.createElement('div');
        dropdown.className = 'autocomplete-dropdown shadow-sm border rounded-3';
        input.parentElement.parentElement.appendChild(dropdown);

        let debounceTimer;

        input.addEventListener('input', function () {
            const q = this.value.trim();
            clearTimeout(debounceTimer);
            if (q.length < 2) { dropdown.classList.remove('show'); return; }

            debounceTimer = setTimeout(async () => {
                try {
                    const res = await fetch('/gigs/api/search?q=' + encodeURIComponent(q));
                    const items = await res.json();
                    if (items.length === 0) { dropdown.classList.remove('show'); return; }

                    dropdown.innerHTML = items.map(item => `
                        <div class="autocomplete-item p-2 border-bottom cursor-pointer" onclick="window.location.href='/gigs/${item.id}'">
                            <div class="fw-bold small text-dark">${item.title}</div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <span class="text-muted" style="font-size: 0.7rem;">${item.category_name} • ${item.worker_name}</span>
                                <span class="text-success fw-bold" style="font-size: 0.75rem;">NPR ${Number(item.starting_price).toLocaleString()}</span>
                            </div>
                        </div>
                    `).join('');
                    dropdown.classList.add('show');
                } catch (e) { dropdown.classList.remove('show'); }
            }, 300);
        });

        document.addEventListener('click', (e) => {
            if (!input.contains(e.target) && !dropdown.contains(e.target)) dropdown.classList.remove('show');
        });
    })();
</script>

<style>
    .autocomplete-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: white;
        z-index: 1000;
        max-height: 300px;
        overflow-y: auto;
        display: none;
    }
    .autocomplete-dropdown.show { display: block; }
    .autocomplete-item:hover { background-color: #f8f9fa; cursor: pointer; }
</style>

<% if (locals.layout === 'dashboard') { %>
<%- include('../partials/dashboard-wrapper-end') %>
<% } else { %>
<%- include('../partials/tail') %>
<% } %>