<%- include('../partials/dashboard-wrapper-start') %>

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
        <a href="/admin" class="text-decoration-none text-muted"><i class="bi bi-arrow-left"></i></a>
        <h1 class="font-display fs-3 fw-semibold mb-0">Categories</h1>
        <span class="text-muted">(<%= categories.length %> total)</span>
    </div>

    <!-- Add a category -->
    <form action="/admin/categories" method="POST" class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h6 class="fw-semibold mb-3">Add a category</h6>
            <div class="d-flex flex-wrap gap-3 align-items-end">
                <div>
                    <label class="form-label small fw-semibold text-muted mb-1">Name</label>
                    <input type="text" name="name" class="form-control form-control-sm" placeholder="e.g. Lighting & Sound" required>
                </div>
                <div class="flex-grow-1">
                    <label class="form-label small fw-semibold text-muted mb-1">Description (optional)</label>
                    <input type="text" name="description" class="form-control form-control-sm" placeholder="Short description shown on browse pages">
                </div>
                <div style="width:110px">
                    <label class="form-label small fw-semibold text-muted mb-1">Sort order</label>
                    <input type="number" name="sort_order" class="form-control form-control-sm" value="0">
                </div>
                <button type="submit" class="btn btn-primary btn-sm">Add category</button>
            </div>
        </div>
    </form>

    <div class="crm-table">
        <table class="table align-middle">
            <thead><tr><th>Name</th><th>Slug</th><th>Gigs</th><th>Jobs</th><th>Sort</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                <% categories.forEach(function(c) { %>
                    <tr>
                        <td class="fw-semibold"><%= c.name %></td>
                        <td class="text-muted small"><code><%= c.slug %></code></td>
                        <td><%= c.gig_count %></td>
                        <td><%= c.job_count %></td>
                        <td><%= c.sort_order %></td>
                        <td><% if (c.is_active) { %><span class="badge-status badge-active">Visible</span><% } else { %><span class="badge-status badge-cancelled">Hidden</span><% } %></td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <form action="/admin/categories/<%= c.id %>?_method=PUT" method="POST" class="d-flex gap-1">
                                    <input type="hidden" name="_method" value="PUT">
                                    <input type="text" name="name" class="form-control form-control-sm" value="<%= c.name %>" style="width:160px">
                                    <input type="number" name="sort_order" class="form-control form-control-sm" value="<%= c.sort_order %>" style="width:80px">
                                    <button type="submit" class="btn btn-sm btn-ek-outline" title="Save changes"><i class="bi bi-check-lg"></i></button>
                                </form>
                                <form action="/admin/categories/<%= c.id %>?_method=PUT" method="POST">
                                    <input type="hidden" name="_method" value="PUT">
                                    <input type="hidden" name="is_active" value="<%= !c.is_active %>">
                                    <% if (c.is_active) { %>
                                        <button type="submit" class="btn btn-sm btn-outline-warning" title="Hide this category"><i class="bi bi-eye-slash"></i></button>
                                    <% } else { %>
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Show this category"><i class="bi bi-eye"></i></button>
                                    <% } %>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>

    <p class="text-muted small mt-2">
        <i class="bi bi-info-circle me-1"></i>Hiding a category removes it from browse pages and the
        gig/job creation forms. Existing gigs and jobs keep their category.
    </p>
</div>

<%- include('../partials/dashboard-wrapper-end') %>
