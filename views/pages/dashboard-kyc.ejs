<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Identity Verification — EventKraft</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/topnav.css">
  <link rel="stylesheet" href="/css/sidebar.css">
  <link rel="stylesheet" href="/css/forms.css">
</head>
<body class="dashboard-body">
  <%- include('../partials/topnav') %>
  <div class="dashboard-shell">
    <%- include('../partials/sidebar') %>
    <main class="dashboard-main">
      <div class="dashboard-main__inner">

        <% if (locals.success && success.length > 0) { %>
          <% success.forEach(function(msg) { %><div class="flash flash--success"><%= msg %></div><% }) %>
        <% } %>
        <% if (locals.error && error.length > 0) { %>
          <% error.forEach(function(msg) { %><div class="flash flash--error"><%= msg %></div><% }) %>
        <% } %>

        <div class="page-header">
          <h1 class="page-title">Identity Verification (KYC)</h1>
          <p class="page-desc">Upload a government-issued document to verify your identity. Required to post services.</p>
        </div>

        <!-- Status banners -->
        <% if (currentUser.kyc_status === 'pending') { %>
          <div class="kyc-banner kyc-banner--pending">
            <span>⏳</span>
            <div>
              <strong>Verification In Progress</strong>
              <p>We received your documents and are reviewing them. This usually takes 24-48 hours.</p>
            </div>
          </div>
        <% } else if (currentUser.kyc_status === 'approved') { %>
          <div class="kyc-banner kyc-banner--approved">
            <span>✅</span>
            <div>
              <strong>Identity Verified</strong>
              <p>Your identity has been verified. You can now post services and receive bookings.</p>
            </div>
          </div>
        <% } else if (currentUser.kyc_status === 'rejected') { %>
          <div class="kyc-banner kyc-banner--rejected">
            <span>❌</span>
            <div>
              <strong>Verification Rejected</strong>
              <p>
                <% if (kycSubmission && kycSubmission.rejection_reason) { %>
                  Reason: <%= kycSubmission.rejection_reason %>
                <% } else { %>
                  Your documents could not be verified. Please resubmit.
                <% } %>
              </p>
            </div>
          </div>
        <% } %>

        <!-- Info card -->
        <div class="kyc-info">
          <h3>Accepted Documents</h3>
          <div class="kyc-docs-grid">
            <div class="kyc-doc-option">🪪 National ID Card</div>
            <div class="kyc-doc-option">📄 Nagarikta (Citizenship)</div>
            <div class="kyc-doc-option">🛂 Passport</div>
            <div class="kyc-doc-option">🚗 Driver's Licence</div>
          </div>
          <div class="kyc-tips">
            <ul>
              <li>Upload clear, unblurred photos of the original document</li>
              <li>All four corners must be visible</li>
              <li>File types: JPG, PNG, or PDF — max 5 MB each</li>
              <li>Document must match the name on your profile</li>
            </ul>
          </div>
        </div>

        <!-- Upload form (show if not pending or approved) -->
        <% if (currentUser.kyc_status !== 'pending' && currentUser.kyc_status !== 'approved') { %>
          <form method="POST" action="/dashboard/kyc/submit" enctype="multipart/form-data">

            <div class="form-group">
              <label class="form-label">Document Type <span class="req">*</span></label>
              <div class="radio-card-row">
                <label class="radio-card">
                  <input type="radio" name="document_type" value="national_id" checked>
                  <span>National ID</span>
                </label>
                <label class="radio-card">
                  <input type="radio" name="document_type" value="nagarikta">
                  <span>Nagarikta</span>
                </label>
                <label class="radio-card">
                  <input type="radio" name="document_type" value="passport">
                  <span>Passport</span>
                </label>
                <label class="radio-card">
                  <input type="radio" name="document_type" value="drivers_licence">
                  <span>Driver's Licence</span>
                </label>
              </div>
            </div>

            <div class="form-row-2" style="margin-bottom: 24px;">
              <div class="form-group">
                <label class="form-label">Front Side <span class="req">*</span></label>
                <div class="upload-zone" id="front-zone">
                  <input type="file" name="doc_front" accept="image/*,.pdf" required onchange="previewDoc(this, 'front')">
                  <div class="upload-zone__inner">
                    <div class="upload-zone__text">📤 Click or drag to upload</div>
                    <div class="upload-zone__hint">JPG, PNG, PDF — Max 5 MB</div>
                  </div>
                  <div class="upload-zone__preview is-hidden" id="front-preview"></div>
                </div>
              </div>
              <div class="form-group">
                <label class="form-label">Back Side <span class="form-hint-inline">(optional)</span></label>
                <div class="upload-zone" id="back-zone">
                  <input type="file" name="doc_back" accept="image/*,.pdf" onchange="previewDoc(this, 'back')">
                  <div class="upload-zone__inner">
                    <div class="upload-zone__text">📤 Click or drag to upload</div>
                    <div class="upload-zone__hint">JPG, PNG, PDF — Max 5 MB</div>
                  </div>
                  <div class="upload-zone__preview is-hidden" id="back-preview"></div>
                </div>
              </div>
            </div>

            <label class="checkbox-row">
              <input type="checkbox" required>
              I confirm that the uploaded document is genuine and belongs to me. I understand that submitting false documents may result in account suspension.
            </label>

            <div class="profile-form-footer">
              <a href="/dashboard" class="btn-outline">Cancel</a>
              <button type="submit" class="btn-primary">Submit for Verification</button>
            </div>

          </form>
        <% } %>

      </div>
    </main>
  </div>

  <script>
  function previewDoc(input, side) {
    const zone = document.getElementById(side + '-zone');
    const preview = document.getElementById(side + '-preview');
    if (!input.files[0]) return;
    zone.classList.add('upload-zone--has-file');
    preview.classList.remove('is-hidden');
    const file = input.files[0];
    if (file.type.startsWith('image/')) {
      const r = new FileReader();
      r.onload = (e) => { preview.innerHTML = `<img src="${e.target.result}" alt="preview">`; };
      r.readAsDataURL(file);
    } else {
      preview.innerHTML = `<div class="upload-zone__pdf-label">📄 ${file.name}</div>`;
    }
  }
  </script>
</body>
</html>
