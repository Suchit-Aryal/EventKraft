<% if (locals.layout === 'dashboard') { %>
<%- include('../partials/dashboard-wrapper-start') %>
<% } else { %>
<%- include('../partials/header') %>
<% } %>

<div class="container py-4">
    <div class="row g-4">
        <!-- Filter Sidebar -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm sticky-top" style="top: 2rem; z-index: 10;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0">Filters</h5>
                        <% if (currentUser && currentUser.role === 'customer') { %>
                            <a href="/jobs/create" class="btn btn-primary btn-sm rounded-pill"><i class="bi bi-plus-lg"></i></a>
                        <% } %>
                    </div>
                    
                    <form action="/jobs" method="GET" id="jobSearchForm">
                        <div class="mb-3">
                            <label for="keyword" class="form-label small fw-semibold text-muted">Search</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" class="form-control border-start-0 ps-0" id="keyword" name="keyword" 
                                    placeholder="Keywords..." value="<%= filters.keyword %>">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="category_id" class="form-label small fw-semibold text-muted">Category</label>
                            <select class="form-select form-select-sm" id="category_id" name="category_id">
                                <option value="">All Categories</option>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat.id %>" <%= filters.category_id === String(cat.id) ? 'selected' : '' %>><%= cat.name %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="location" class="form-label small fw-semibold text-muted">Location</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-geo-alt text-muted"></i></span>
                                <input type="text" class="form-control border-start-0 ps-0" id="location" name="location"
                                    placeholder="e.g. Kathmandu" value="<%= filters.location %>" list="cityOptions" autocomplete="off">
                                <datalist id="cityOptions">
                                    <% (locals.nepalCities || []).forEach(function(city) { %>
                                        <option value="<%= city %>"></option>
                                    <% }); %>
                                </datalist>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-semibold text-muted">Budget Range</label>
                            <div class="d-flex gap-2 align-items-center">
                                <input type="number" class="form-control form-control-sm" name="minBudget" placeholder="Min" value="<%= filters.minBudget %>">
                                <span class="text-muted small">to</span>
                                <input type="number" class="form-control form-control-sm" name="maxBudget" placeholder="Max" value="<%= filters.maxBudget %>">
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-sm">Apply Filters</button>
                            <a href="/jobs" class="btn btn-outline-secondary btn-sm">Clear All</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h2 class="fw-bold mb-1">Available Gigs</h2>
                    <p class="text-muted small mb-0">Browse event projects and submit your proposals</p>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="text-muted small"><span class="fw-bold text-dark"><%= jobs.length %></span> gigs found</span>
                    <form action="/jobs" method="GET" class="mb-0">
                        <% ['keyword','category_id','minBudget','maxBudget','location'].forEach(function(k) { %>
                            <% if (filters[k]) { %><input type="hidden" name="<%= k %>" value="<%= filters[k] %>"><% } %>
                        <% }); %>
                        <select class="form-select form-select-sm" name="sort" onchange="this.form.submit()" aria-label="Sort gigs" style="width:auto">
                            <option value="newest" <%= !filters.sort || filters.sort === 'newest' ? 'selected' : '' %>>Newest first</option>
                            <option value="budget_high" <%= filters.sort === 'budget_high' ? 'selected' : '' %>>Highest budget</option>
                            <option value="event_soon" <%= filters.sort === 'event_soon' ? 'selected' : '' %>>Event date: soonest</option>
                            <option value="deadline_soon" <%= filters.sort === 'deadline_soon' ? 'selected' : '' %>>Deadline: soonest</option>
                        </select>
                    </form>
                </div>
            </div>

            <!-- Active filter chips -->
            <%
                var chipDefs = [
                    { key: 'keyword', label: filters.keyword ? '"' + filters.keyword + '"' : '' },
                    { key: 'category_id', label: (function(){ var c = categories.find(function(x){ return String(x.id) === filters.category_id; }); return c ? c.name : ''; })() },
                    { key: 'location', label: filters.location },
                    { key: 'minBudget', label: filters.minBudget ? 'Min NPR ' + Number(filters.minBudget).toLocaleString() : '' },
                    { key: 'maxBudget', label: filters.maxBudget ? 'Max NPR ' + Number(filters.maxBudget).toLocaleString() : '' }
                ].filter(function(c) { return c.label; });
            %>
            <% if (chipDefs.length > 0) { %>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <% chipDefs.forEach(function(chip) { %>
                        <%
                            var params = [];
                            ['keyword','category_id','minBudget','maxBudget','location','sort'].forEach(function(k) {
                                if (k !== chip.key && filters[k]) params.push(k + '=' + encodeURIComponent(filters[k]));
                            });
                            var removeUrl = '/jobs' + (params.length ? '?' + params.join('&') : '');
                        %>
                        <a href="<%= removeUrl %>" class="filter-chip text-decoration-none">
                            <%= chip.label %> <i class="bi bi-x"></i>
                        </a>
                    <% }); %>
                    <a href="/jobs" class="small text-muted text-decoration-none">Clear all</a>
                </div>
            <% } %>

            <% if (jobs && jobs.length > 0) { %>
                <div class="row g-4">
                    <% jobs.forEach(job => { %>
                        <div class="col-12">
                            <div class="card h-100 border-0 shadow-sm hover-lift job-card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <div class="d-flex flex-wrap gap-1 mb-2">
                                                <span class="badge bg-light text-primary"><%= job.category_name %></span>
                                                <% if (job.event_type) { %>
                                                    <span class="badge bg-light text-secondary"><%= job.event_type %></span>
                                                <% } %>
                                                <%
                                                    var deadlineBadge = null;
                                                    if (job.proposal_deadline) {
                                                        var msLeft = new Date(job.proposal_deadline) - Date.now();
                                                        var daysLeft = Math.ceil(msLeft / 86400000);
                                                        if (daysLeft < 0) deadlineBadge = { cls: 'bg-secondary-subtle text-secondary', text: 'Closed' };
                                                        else if (daysLeft <= 3) deadlineBadge = { cls: 'bg-danger-subtle text-danger', text: daysLeft <= 1 ? 'Closes today' : 'Closes in ' + daysLeft + ' days' };
                                                        else if (daysLeft <= 7) deadlineBadge = { cls: 'bg-warning-subtle text-warning-emphasis', text: 'Closes in ' + daysLeft + ' days' };
                                                    }
                                                %>
                                                <% if (deadlineBadge) { %>
                                                    <span class="badge <%= deadlineBadge.cls %>"><i class="bi bi-hourglass-split me-1"></i><%= deadlineBadge.text %></span>
                                                <% } %>
                                            </div>
                                            <h5 class="fw-bold mb-1">
                                                <a href="/jobs/<%= job.id %>" class="text-dark text-decoration-none stretched-link">
                                                    <%= job.title %>
                                                </a>
                                            </h5>
                                            <div class="d-flex flex-wrap align-items-center gap-3 text-muted small">
                                                <span><i class="bi bi-person-circle me-1"></i><%= job.customer_first_name %> <%= job.customer_last_name %></span>
                                                <% if (job.event_location) { %>
                                                    <span><i class="bi bi-geo-alt me-1"></i><%= job.event_location %></span>
                                                <% } %>
                                                <% if (job.event_date) { %>
                                                    <span><i class="bi bi-calendar-event me-1"></i><%= new Date(job.event_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                                                <% } %>
                                                <span><i class="bi bi-clock me-1"></i>Posted <%= new Date(job.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %></span>
                                            </div>
                                        </div>
                                        <div class="text-end flex-shrink-0 ms-3">
                                            <div class="fw-bold text-success">NPR <%= Number(job.budget_min).toLocaleString() %> – <%= Number(job.budget_max).toLocaleString() %></div>
                                            <div class="text-muted small mt-1"><i class="bi bi-people me-1"></i><%= job.proposal_count || 0 %> proposal<%= Number(job.proposal_count) === 1 ? '' : 's' %></div>
                                        </div>
                                    </div>
                                    <p class="text-muted small mb-0 line-clamp-2">
                                        <%= job.description %>
                                    </p>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-binoculars d-block mb-3" style="font-size:3rem;opacity:.3"></i>
                        <h4>No gigs found</h4>
                        <p class="text-muted">Try adjusting your filters or search terms.</p>
                        <a href="/jobs" class="btn btn-primary btn-sm">Clear All Filters</a>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<style>
    .hover-lift { transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out; }
    .hover-lift:hover { transform: translateY(-3px); box-shadow: 0 0.5rem 1.5rem rgba(0,0,0,.08) !important; }
    .job-card { border-left: 4px solid transparent !important; transition: border-color 0.2s; }
    .job-card:hover { border-left-color: var(--bs-primary) !important; }
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .filter-chip {
        display: inline-flex; align-items: center; gap: .25rem;
        font-size: .78rem; font-weight: 600;
        padding: .25rem .7rem; border-radius: 50px;
        background: rgba(107,29,42,.08); color: var(--ek-maroon, #6b1d2a);
        border: 1px solid rgba(107,29,42,.15);
    }
    .filter-chip:hover { background: rgba(107,29,42,.15); color: var(--ek-maroon, #6b1d2a); }
</style>

<!-- Autocomplete Logic -->
<script>
    (function () {
        const input = document.getElementById('keyword');
        if (!input) return;

        const dropdown = document.createElement('div');
        dropdown.className = 'autocomplete-dropdown shadow-sm border rounded-3';
        input.parentElement.parentElement.appendChild(dropdown);

        let debounceTimer;

        input.addEventListener('input', function () {
            const q = this.value.trim();
            clearTimeout(debounceTimer);
            if (q.length < 2) { dropdown.classList.remove('show'); return; }

            debounceTimer = setTimeout(async () => {
                try {
                    const res = await fetch('/jobs/api/search?q=' + encodeURIComponent(q));
                    const items = await res.json();
                    if (items.length === 0) { dropdown.classList.remove('show'); return; }

                    dropdown.innerHTML = items.map(item => `
                        <div class="autocomplete-item p-2 border-bottom cursor-pointer" onclick="window.location.href='/jobs/${item.id}'">
                            <div class="fw-bold small text-dark">${item.title}</div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <span class="text-muted" style="font-size: 0.7rem;">${item.category_name} • ${item.customer_name}</span>
                                <span class="text-success fw-bold" style="font-size: 0.75rem;">NPR ${Number(item.budget_min).toLocaleString()} - ${Number(item.budget_max).toLocaleString()}</span>
                            </div>
                        </div>
                    `).join('');
                    dropdown.classList.add('show');
                } catch (e) { dropdown.classList.remove('show'); }
            }, 300);
        });

        document.addEventListener('click', (e) => {
            if (!input.contains(e.target) && !dropdown.contains(e.target)) dropdown.classList.remove('show');
        });
    })();
</script>

<style>
    .autocomplete-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: white;
        z-index: 1000;
        max-height: 300px;
        overflow-y: auto;
        display: none;
    }
    .autocomplete-dropdown.show { display: block; }
    .autocomplete-item:hover { background-color: #f8f9fa; cursor: pointer; }
</style>

<% if (locals.layout === 'dashboard') { %>
<%- include('../partials/dashboard-wrapper-end') %>
<% } else { %>
<%- include('../partials/tail') %>
<% } %>