<%- include('../partials/dashboard-wrapper-start') %>

<div class="container py-4" style="max-width:800px">
    <a href="/messages" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> Back to messages
    </a>

    <div class="ek-card ek-chat-wrap chat-light" style="border-radius:16px;overflow:hidden"
         id="chat-container"
         data-conversation-id="<%= conversation.id %>"
         data-user-id="<%= currentUser.id %>"
         data-user-name="<%= currentUser.email.split('@')[0] %>"
         data-receiver-id="<%= conversation.participant_1 === currentUser.id ? conversation.participant_2 : conversation.participant_1 %>">

        <!-- Header -->
        <div class="ek-chat-header d-flex align-items-center justify-content-between" style="padding:12px 16px">
            <div class="d-flex align-items-center gap-3">
                <img src="<%= otherAvatar || ('https://ui-avatars.com/api/?name='+(otherName||'U')+'&background=6b1d2a&color=fff') %>" alt="" style="width:40px;height:40px;border-radius:50%;object-fit:cover">
                <div>
                    <strong style="font-size:.95rem"><%= otherName || 'User' %></strong>
                    <p class="mb-0" style="font-size:.75rem;opacity:.6">Conversation</p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <!-- Theme toggle -->
                <button class="btn btn-sm" id="themeToggle" title="Toggle dark/light" style="border:1px solid var(--chat-border);border-radius:50%;width:34px;height:34px;display:flex;align-items:center;justify-content:center;background:transparent;color:var(--chat-text)">
                    <i class="bi bi-moon-fill" id="themeIcon"></i>
                </button>
            </div>
        </div>

        <!-- Messages -->
        <div id="messageArea" class="ek-chat-area" style="height:460px;overflow-y:auto;padding:16px">
            <% if (messages && messages.length > 0) { %>
                <% messages.forEach(function(m) { %>
                    <div id="msg-<%= m.id %>" class="d-flex mb-3 msg-wrap <%= m.sender_id === currentUser.id ? 'justify-content-end' : 'justify-content-start' %> <%= m.is_unsent ? 'msg-unsent' : '' %>" style="position:relative" data-msg-id="<%= m.id %>" data-sender="<%= m.sender_id %>" data-content="<%= m.is_unsent ? '' : m.content %>">
                        <div class="<%= m.sender_id === currentUser.id ? 'chat-sent' : 'chat-received' %>" style="max-width:70%;padding:.6rem 1rem;border-radius:16px;position:relative">
                            <% if (m.reply_content) { %>
                                <div class="msg-reply-preview"><strong><%= m.reply_sender_name || 'User' %>:</strong> <%= m.reply_content.substring(0, 60) %></div>
                            <% } %>
                            <% if (m.file_url && !m.is_unsent) { %>
                                <% if (m.file_type && m.file_type.startsWith('image/')) { %>
                                    <a href="<%= m.file_url %>" target="_blank"><img src="<%= m.file_url %>" alt="<%= m.file_name %>" style="max-width:100%;border-radius:8px;margin-bottom:4px;max-height:200px"></a>
                                <% } else { %>
                                    <a href="<%= m.file_url %>" target="_blank" class="msg-file-preview">
                                        <i class="bi bi-file-earmark-<%= m.file_type === 'application/pdf' ? 'pdf' : 'zip' %>-fill"></i>
                                        <span style="font-size:.8rem"><%= m.file_name || 'File' %></span>
                                    </a>
                                <% } %>
                            <% } %>
                            <% if (m.is_unsent) { %>
                                <p class="mb-0" style="font-size:.85rem;font-style:italic;opacity:.5"><i class="bi bi-x-circle me-1"></i>This message was unsent</p>
                            <% } else { %>
                                <p class="mb-0" style="font-size:.9rem"><%= m.content %></p>
                            <% } %>
                            <small class="msg-time" style="opacity:.5;font-size:.7rem"><%= new Date(m.created_at).toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'}) %></small>
                        </div>
                        <% if (!m.is_unsent) { %>
                        <div class="msg-actions">
                            <button class="msg-action-btn" title="Reply" onclick="setReply('<%= m.id %>','<%= (m.sender_name || 'User').replace(/'/g, "\\'") %>','<%= (m.content || '').substring(0,50).replace(/'/g, "\\'") %>')"><i class="bi bi-reply-fill"></i></button>
                            <% if (m.sender_id === currentUser.id) { %>
                                <button class="msg-action-btn" title="Unsend" onclick="unsendMsg('<%= m.id %>')"><i class="bi bi-x-circle"></i></button>
                            <% } %>
                        </div>
                        <% } %>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="text-center py-5" style="color:var(--chat-muted)" id="emptyChat">
                    <i class="bi bi-chat fs-1"></i>
                    <p class="mt-2">No messages yet. Say hello!</p>
                </div>
            <% } %>
        </div>

        <!-- Reply bar (hidden by default) -->
        <div class="reply-bar d-none" id="replyBar">
            <i class="bi bi-reply-fill" style="color:var(--chat-sent-bg)"></i>
            <div class="reply-preview" id="replyPreview"></div>
            <button class="btn btn-sm p-0" onclick="clearReply()" style="color:var(--chat-muted)"><i class="bi bi-x-lg"></i></button>
        </div>

        <!-- File preview bar (hidden by default) -->
        <div class="file-preview-bar d-none" id="fileBar">
            <i class="bi bi-paperclip"></i>
            <span id="fileBarName" style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"></span>
            <button class="btn btn-sm p-0" onclick="clearFile()" style="color:var(--chat-muted)"><i class="bi bi-x-lg"></i></button>
        </div>

        <!-- Send bar -->
        <div class="ek-chat-footer" style="padding:10px 16px">
            <form id="messageForm" class="d-flex align-items-center gap-2">
                <!-- File attach -->
                <input type="file" id="chatFileInput" accept="image/*,.pdf,.zip,.rar" style="display:none">
                <button type="button" class="btn btn-sm" onclick="document.getElementById('chatFileInput').click()" style="border:none;background:transparent;color:var(--chat-muted);font-size:1.2rem" title="Attach file">
                    <i class="bi bi-paperclip"></i>
                </button>
                <!-- Image attach -->
                <button type="button" class="btn btn-sm" onclick="pickImage()" style="border:none;background:transparent;color:var(--chat-muted);font-size:1.2rem" title="Send photo">
                    <i class="bi bi-image"></i>
                </button>
                <input type="text" id="messageInput" class="form-control" placeholder="Type a message…" autocomplete="off" style="border-radius:50px;flex:1">
                <button type="submit" class="btn btn-primary" style="border-radius:50px;padding:.45rem 1rem"><i class="bi bi-send-fill"></i></button>
            </form>
        </div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/chat.js"></script>

<%- include('../partials/dashboard-wrapper-end') %>
