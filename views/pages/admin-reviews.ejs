<%- include('../partials/dashboard-wrapper-start') %>

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
        <a href="/admin" class="text-decoration-none text-muted"><i class="bi bi-arrow-left"></i></a>
        <h1 class="font-display fs-3 fw-semibold mb-0">Review Moderation</h1>
        <span class="text-muted">(latest <%= reviews.length %>)</span>
    </div>

    <% if (reviews.length > 0) { %>
        <div class="crm-table">
            <table class="table align-middle">
                <thead><tr><th>Date</th><th>Reviewer</th><th>Reviewee</th><th>Rating</th><th>Comment</th><th>Visibility</th><th>Actions</th></tr></thead>
                <tbody>
                    <% reviews.forEach(function(r) { %>
                        <tr>
                            <td class="text-muted small"><%= new Date(r.created_at).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}) %></td>
                            <td>
                                <div class="fw-semibold small"><%= (r.reviewer_first_name || '') %> <%= (r.reviewer_last_name || '') %></div>
                                <div class="text-muted" style="font-size:.75rem"><%= r.reviewer_email %></div>
                            </td>
                            <td class="small"><%= (r.reviewee_first_name || '') %> <%= (r.reviewee_last_name || '') %></td>
                            <td class="fw-semibold"><%= r.rating %> <i class="bi bi-star-fill" style="color:var(--ek-warning, #f5a623)"></i></td>
                            <td class="small" style="max-width:320px"><%= r.comment || '—' %></td>
                            <td><% if (r.is_public) { %><span class="badge-status badge-active">Public</span><% } else { %><span class="badge-status badge-cancelled">Hidden</span><% } %></td>
                            <td>
                                <div class="d-flex gap-1">
                                    <form action="/admin/reviews/<%= r.id %>?_method=PUT" method="POST">
                                        <input type="hidden" name="_method" value="PUT">
                                        <input type="hidden" name="is_public" value="<%= !r.is_public %>">
                                        <% if (r.is_public) { %>
                                            <button type="submit" class="btn btn-sm btn-outline-warning" title="Hide this review"><i class="bi bi-eye-slash"></i></button>
                                        <% } else { %>
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Make this review public"><i class="bi bi-eye"></i></button>
                                        <% } %>
                                    </form>
                                    <form action="/admin/reviews/<%= r.id %>?_method=DELETE" method="POST"
                                          onsubmit="return confirm('Delete this review? The reviewee\'s average rating will be recalculated. This cannot be undone.');">
                                        <input type="hidden" name="_method" value="DELETE">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete review"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="empty-state"><i class="bi bi-star"></i><p>No reviews yet.</p></div>
    <% } %>
</div>

<%- include('../partials/dashboard-wrapper-end') %>
