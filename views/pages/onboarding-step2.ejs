<%- include('../partials/header') %>

<div class="container py-5" style="max-width:500px">
    <h2 class="font-display fs-3 fw-semibold mb-1">Tell us about yourself</h2>
    <p class="text-muted mb-4">Your details help clients and workers find you.</p>

    <form method="POST" action="/onboarding/step2" class="ek-form">
        <div class="row g-3 mb-3">
            <div class="col-6">
                <label class="form-label" for="first_name">First Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="first_name" name="first_name"
                    value="<%= profile.first_name || '' %>" required>
            </div>
            <div class="col-6">
                <label class="form-label" for="last_name">Last Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="last_name" name="last_name"
                    value="<%= profile.last_name || '' %>" required>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="phone">Phone Number <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text">+977</span>
                <input type="tel" class="form-control" id="phone" name="phone"
                    placeholder="98XXXXXXXX" pattern="[0-9]{10}" maxlength="10" required>
            </div>
            <small class="text-muted">Required for booking confirmations</small>
        </div>

        <div class="mb-4">
            <label class="form-label" for="address">Address <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="address" name="address"
                placeholder="e.g. Thamel, Kathmandu" required>
            <small class="text-muted">Your general location — used to match you with nearby clients/workers</small>
        </div>

        <div class="d-flex justify-content-between">
            <a href="/onboarding/step1" class="btn btn-ek-outline btn-lg">← Back</a>
            <button type="submit" class="btn btn-ek-primary btn-lg">Continue →</button>
        </div>
    </form>

    <div class="d-flex justify-content-center gap-2 mt-4">
        <span class="rounded-circle" style="width:8px;height:8px;background:var(--ek-maroon)"></span>
        <span class="rounded-circle bg-dark" style="width:8px;height:8px"></span>
        <span class="rounded-circle bg-secondary" style="width:8px;height:8px;opacity:.3"></span>
    </div>
</div>

<%- include('../partials/tail') %>
